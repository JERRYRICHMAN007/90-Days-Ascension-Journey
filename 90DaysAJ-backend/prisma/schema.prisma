// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String    @db.VarChar(100)
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @db.VarChar(255)
  avatarKey     String?   @db.VarChar(255)
  avatarUrl     String?   @db.VarChar(500)
  emailVerified Boolean   @default(false)
  emailVerifiedAt DateTime?
  preferences   Json?     @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens RefreshToken[]
  passwordResets PasswordReset[]
  files         File[]
  domains       Domain[]
  tasks         Task[]
  achievements  Achievement[]
  logs          Log[]

  @@index([email])
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @db.VarChar(255)
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([userId, revoked])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique @db.VarChar(255)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([userId, used])
  @@map("password_resets")
}

model File {
  id        String   @id @default(uuid())
  userId    String
  key       String   @unique @db.VarChar(500)
  url       String   @db.VarChar(1000)
  type      String   @db.VarChar(50) // 'avatar' | 'resource' | 'other'
  size      Int
  width     Int?
  height    Int?
  meta      Json?    @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([key])
  @@index([userId, type])
  @@index([createdAt])
  @@map("files")
}

model Domain {
  id          String   @id @default(uuid())
  userId      String
  domainId    String   @db.VarChar(100) // 'body-transformation' | 'dual-brand' | etc.
  name        String   @db.VarChar(200)
  totalDays   Int      @default(90)
  completedDays Int    @default(0)
  progress    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]
  logs  Log[]

  @@unique([userId, domainId])
  @@index([userId])
  @@index([userId, progress])
  @@index([updatedAt])
  @@map("domains")
}

model Task {
  id          String   @id @default(uuid())
  userId      String
  domainId    String
  dayNumber   Int
  completed   Boolean  @default(false)
  completedAt DateTime?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([userId, domainId, dayNumber])
  @@index([userId, domainId])
  @@index([userId, domainId, completed])
  @@index([completedAt])
  @@map("tasks")
}

model Achievement {
  id          String   @id @default(uuid())
  userId      String
  achievementId String @db.VarChar(100) // '3-day-start' | 'week-warrior' | etc.
  unlockedAt  DateTime @default(now())
  meta        Json?    @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([userId, unlockedAt])
  @@index([unlockedAt])
  @@map("achievements")
}

model Log {
  id        String   @id @default(uuid())
  userId    String
  domainId  String
  dayNumber Int?
  type      String   @db.VarChar(50) // 'workout' | 'reading' | 'writing' | etc.
  data      Json?
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([userId, domainId])
  @@index([userId, domainId, type])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("logs")
}

