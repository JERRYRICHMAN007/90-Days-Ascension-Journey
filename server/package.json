{
  "name": "@aether/server",
  "version": "1.0.0",
  "description": "Backend API for Aether",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run prisma:generate && cross-env PORT=5001 HOST=127.0.0.1 tsx watch src/index.ts",
    "build": "prisma generate",
    "start": "tsx src/index.ts",
    "start:prod": "cross-env NODE_ENV=production node scripts/start-production.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx src/prisma/seed.ts",
    "check:env": "node scripts/check-env.mjs",
    "dev:reset-password": "node scripts/reset-dev-password.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:ai": "tsc -p tsconfig.domain-ai.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/s3-request-presigner": "^3.490.0",
    "@prisma/client": "^5.7.1",
    "@sendgrid/mail": "^8.1.0",
    "@supabase/supabase-js": "^2.87.0",
    "argon2": "^0.31.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.7.1",
    "sharp": "^0.33.1",
    "tsx": "^4.7.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "cross-env": "^7.0.3"
  }
}
