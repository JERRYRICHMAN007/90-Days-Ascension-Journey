// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  passwordHash    String
  avatarKey       String?
  avatarUrl       String?
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  preferences     Json?     @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  files          File[]
  domains        Domain[]
  tasks          Task[]
  achievements   Achievement[]
  logs           Log[]

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_resets")
}

model File {
  id        String   @id @default(uuid())
  userId    String
  key       String   @unique
  url       String
  type      String // 'avatar' | 'resource' | 'other'
  size      Int
  width     Int?
  height    Int?
  meta      Json?    @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([key])
  @@map("files")
}

model Domain {
  id            String   @id @default(uuid())
  userId        String
  domainId      String // 'body-transformation' | 'dual-brand' | etc.
  name          String
  totalDays     Int      @default(90)
  completedDays Int      @default(0)
  progress      Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]
  logs  Log[]

  @@unique([userId, domainId])
  @@index([userId])
  @@map("domains")
}

model Task {
  id          String    @id @default(uuid())
  userId      String
  domainId    String
  dayNumber   Int
  completed   Boolean   @default(false)
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([userId, domainId, dayNumber])
  @@index([userId, domainId])
  @@map("tasks")
}

model Achievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String // '3-day-start' | 'week-warrior' | etc.
  unlockedAt    DateTime @default(now())
  meta          Json?    @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("achievements")
}

model Log {
  id        String   @id @default(uuid())
  userId    String
  domainId  String
  dayNumber Int?
  type      String // 'workout' | 'reading' | 'writing' | etc.
  data      Json?
  notes     String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([userId, domainId])
  @@map("logs")
}
