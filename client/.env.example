# API Configuration
# Copy this file to .env.local for local development
# For production, set these in Vercel Dashboard â†’ Settings â†’ Environment Variables

# Backend API URL
# Development: http://localhost:5001/v1
# Production: https://your-backend-url.com/v1 (e.g., Railway, Render, etc.)
# Unified dev: Vite proxies /v1 → API on port 5001
VITE_API_BASE_URL=/v1

# Or direct (without proxy):
# VITE_API_BASE_URL=http://localhost:5001/v1
